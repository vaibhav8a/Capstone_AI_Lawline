FROM python:3.12-slim

# System libraries needed for legal PDF processing
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    libglib2.0-0 \
    libgl1 \
    libsm6 \
    libxext6 \
    libxrender1 \
    tesseract-ocr \
    tesseract-ocr-hin \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python deps (only what the worker actually needs)
COPY requirements.txt .
RUN pip install --no-cache-dir \
    rq \
    redis \
    chromadb \
    rank-bm25 \
    sentence-transformers \
    diskcache \
    python-dotenv \
    unstructured[pdf] \
    opencv-python-headless \
    pytesseract \
    groq

# Copy backend source
COPY . .

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

CMD ["rq", "worker", "legal-rag", "--url", "redis://redis:6379"]
