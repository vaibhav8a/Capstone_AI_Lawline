# ══════════════════════════════════════════════════════════════
# Legal RAG Pro - Environment Configuration
# Copy to .env and fill in your values
# ══════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────
# LLM Configuration (Required for cheat sheet generation)
# ─────────────────────────────────────────────────────────────

# Get API key from: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# Supported backends: groq, openai, gemini, ollama
RAG_LLM_BACKEND=groq

# OpenAI API key (if using OpenAI backend)
# OPENAI_API_KEY=sk_your_openai_key

# ─────────────────────────────────────────────────────────────
# Redis Configuration (For job queue)
# ─────────────────────────────────────────────────────────────

# Default: redis://localhost:6379 (local Redis)
# For remote Redis: redis://username:password@host:port/db
REDIS_URL=redis://localhost:6379/0

# ─────────────────────────────────────────────────────────────
# Authentication Configuration
# ─────────────────────────────────────────────────────────────

# Set to 'false' to require JWT tokens
# Set to 'true' to bypass auth (all endpoints open, no token needed)
# Default: true (recommended for development)
DISABLE_AUTH=true

# Secret key for JWT signing (change this in production!)
# Min 32 characters recommended
JWT_SECRET_KEY=super-secret-change-me-in-production-to-32-chars

# Token expiry in minutes
JWT_EXPIRE_MINUTES=60

# ─────────────────────────────────────────────────────────────
# Observability & Monitoring
# ─────────────────────────────────────────────────────────────

# OpenTelemetry endpoint (optional, for distributed tracing)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Enable Prometheus metrics scraping
# Default: http://localhost:8000/metrics
PROMETHEUS_ENABLED=true

# ─────────────────────────────────────────────────────────────
# Advanced Configuration
# ─────────────────────────────────────────────────────────────

# Embedding batch size (increase for faster processing, decrease if OOM)
EMBEDDING_BATCH=32

# Reranker top K results to return
RERANKER_TOP_K=5

# Hybrid retrieval top K candidates before reranking
HYBRID_TOP_K=40

# Query decomposition (split complex queries into sub-queries)
QUERY_DECOMPOSE_ENABLED=true

# HyDE (Hypothetical Document Embeddings)
HYDE_ENABLED=true

# Self-RAG (LLM hallucination detection)
SELF_RAG_ENABLED=true

# Cache results (DiskCache)
CACHE_ENABLED=true

# Cache TTL in hours
CACHE_TTL_HOURS=24

# Rate limiting (disable for development)
RATE_LIMITING_ENABLED=false

# ─────────────────────────────────────────────────────────────
# Model Configuration
# ─────────────────────────────────────────────────────────────

# Embedding model (multilingual: HI, KN, TA, TE supported)
# Default: BAAI/bge-m3 (1024 dimensions)
# Alternative: BAAI/bge-base-en-v1.5
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# Cross-encoder for reranking
# Default: cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Groq model selection
# Options: llama-3.1-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_MODEL=llama-3.1-70b-versatile

# ─────────────────────────────────────────────────────────────
# Data Paths (usually don't need to change)
# ─────────────────────────────────────────────────────────────

# INPUT_FOLDER=./input
# OUTPUT_FOLDER=./outputs
# WATCH_FOLDER=./Dataset
# PROCESSED_JSON_FOLDER=./backend/processed_json

# ─────────────────────────────────────────────────────────────
# Development Settings
# ─────────────────────────────────────────────────────────────

# Set to 'development' for debug logging
ENVIRONMENT=development

# Backend server port
BACKEND_PORT=8000

# Frontend port
FRONTEND_PORT=5173

# Allow CORS from frontend
FRONTEND_URL=http://localhost:5173

# ──────────────────────────────────────────────────────────────
# Notes for Law Students
# ──────────────────────────────────────────────────────────────
#
# The default configuration is optimized for learning:
# - Auth is disabled (all features accessible)
# - Caching is enabled (faster queries)
# - HyDE and Self-RAG are enabled (better answers)
# - Metrics are enabled (see what's happening)
#
# For production deployment:
# - Enable authentication (DISABLE_AUTH=false)
# - Use a proper database for users
# - Configure Redis for distributed caching
# - Set up monitoring with OpenTelemetry
# - Use HTTPS and configure CORS properly
#
# ──────────────────────────────────────────────────────────────
